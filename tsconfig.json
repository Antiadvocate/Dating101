{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "paths": { "@weft/*": ["./vendor/weft/src/*"] },
    "baseUrl": "."
  },
  "include": ["src", "vendor/weft/src"],
  "exclude": ["vendor/weft/tests", "vendor/weft/relay", "vendor/weft/tools"]
}
